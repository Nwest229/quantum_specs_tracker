# Copy to .env for local development. Never commit real secrets.
# All qscrape-specific settings are prefixed QSCRAPE_ (see src/qscrape/settings.py).

# -- logging --------------------------------------------------------------
QSCRAPE_LOG_LEVEL=INFO
QSCRAPE_LOG_JSON=true

# -- paths ------------------------------------------------------------------
# Defaults are computed relative to the repo root; override only if you need
# a non-standard layout.
QSCRAPE_CONFIG_PATH=config/sources.json
QSCRAPE_OUT_PATH=data/backends.json
QSCRAPE_XLSX_PATH=data/quantum_tracker.xlsx
QSCRAPE_CACHE_DIR=.cache

# -- fetch behaviour ---------------------------------------------------------
# Per-source values in config/sources.json take precedence over these.
QSCRAPE_CACHE_MAX_AGE=86400
QSCRAPE_REQUEST_DELAY=1.0

# -- IBM Quantum Runtime credentials -----------------------------------------
# Required for the IBM adapter to pull real per-gate calibration data; without
# it IBM falls back to hand-entered values in config/sources.json.
# QSCRAPE_IBM_QUANTUM_TOKEN is preferred; the historical unprefixed
# IBM_QUANTUM_TOKEN name is also accepted for backward compatibility.
QSCRAPE_IBM_QUANTUM_TOKEN=
IBM_QUANTUM_TOKEN=

# -- AWS credentials for the Braket adapter ----------------------------------
# amazon-braket-sdk / boto3 resolve these via the standard AWS credential
# chain on their own (env vars, ~/.aws/credentials, instance profile, ...).
# qscrape does not read them directly today; they are documented here so
# operators have one place to see/set them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
